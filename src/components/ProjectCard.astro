---
import type { Project } from '../data/projects';
import { withBase } from '../utils/paths';

interface Props {
  project: Project;
}

const { project } = Astro.props as Props;
---

<article class="card project-card" data-project-card data-categories={project.categories.join(' ')}>
  <div class="eyebrow">{project.categories.join(' · ')}</div>
  <h3>{project.title}</h3>
  <p>{project.shortSummary}</p>
  <div class="tag-list">
    {project.technologies.slice(0, 4).map((technology: string) => <span>{technology}</span>)}
  </div>
  <a class="text-link" href={withBase(`projects/${project.slug}/`)}>
    Read case study <span aria-hidden="true">↗</span>
  </a>
</article>
