---
interface Props { steps: string[]; conceptual?: boolean; }
const { steps, conceptual = false } = Astro.props;
---
<div class="architecture-flow" data-conceptual={conceptual ? 'true' : undefined}>
  {conceptual && <p class="architecture-label">Conceptual pipeline</p>}
  <ol>{steps.map((step, index) => <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><p>{step}</p></li>)}</ol>
</div>
