---
import '../styles/global.css';
import { assetUrl, canonicalUrl, personJsonLd, socialImageUrl } from '../utils/seo';
import { site } from '../data/site';
import CommandPalette from '../components/CommandPalette.astro';
interface Props { title?: string; description?: string; canonicalPath?: string; image?: string; structuredData?: Record<string, unknown>; }
const { title = site.title, description = site.description, canonicalPath = '/', image, structuredData } = Astro.props as Props;
const canonical = canonicalUrl(canonicalPath);
const imageUrl = socialImageUrl(canonicalPath, image);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta property="og:type" content="website" /><meta property="og:site_name" content="Anson Lin" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />{imageUrl && <meta property="og:image" content={imageUrl} />}<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />{imageUrl && <meta name="twitter:image" content={imageUrl} />}<link rel="icon" href={assetUrl('favicon.svg')} /><script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData ?? (canonicalPath === '/' ? personJsonLd : undefined))}></script></head><body><slot /><CommandPalette /><script is:inline>
document.documentElement.classList.add('js');
const nav=document.querySelector('[data-nav]'),toggle=document.querySelector('[data-menu]'); const closeNav=(restore=false)=>{nav?.setAttribute('data-open','false');toggle?.setAttribute('aria-expanded','false');if(restore)toggle?.focus()}; toggle?.addEventListener('click',()=>{const next=nav?.getAttribute('data-open')!=='true';nav?.setAttribute('data-open',String(next));toggle.setAttribute('aria-expanded',String(next))}); nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{closeNav();setTimeout(()=>toggle?.focus(),0)}));
const dialog=document.querySelector('[data-palette]'),input=document.querySelector('[data-palette-input]'),opener=document.querySelector('[data-command]'),items=[...document.querySelectorAll('[data-palette-items] a')];let active=0;const setActive=()=>items.forEach((a,i)=>a.setAttribute('aria-current',i===active?'true':'false'));const open=()=>{dialog?.removeAttribute('hidden');active=0;setActive();input?.focus()};const close=()=>{dialog?.setAttribute('hidden','');opener?.focus()};opener?.addEventListener('click',open);items.forEach(a=>a.addEventListener('click',close));document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();open()}if(e.key==='Escape'){if(dialog&&!dialog.hasAttribute('hidden'))close();closeNav(true)}if(dialog&&!dialog.hasAttribute('hidden')){if(e.key==='ArrowDown'){e.preventDefault();active=(active+1)%items.length;setActive()}if(e.key==='ArrowUp'){e.preventDefault();active=(active+items.length-1)%items.length;setActive()}if(e.key==='Enter'){e.preventDefault();items[active]?.click()}}});
document.querySelectorAll('[data-filter]').forEach(button=>button.addEventListener('click',()=>{const filter=button.dataset.filter||'All';document.querySelectorAll('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelectorAll('[data-project-card]').forEach(card=>{const categories=(card.dataset.categories||'').split(' ');card.toggleAttribute('hidden',filter!=='All'&&!categories.includes(filter.toLowerCase().replace(' and ','-')))})}));
document.querySelector('[data-copy]')?.addEventListener('click',async e=>{const b=e.currentTarget,s=b.nextElementSibling;try{await navigator.clipboard.writeText(b.dataset.copy);s.textContent='Email copied.'}catch{s.textContent='Copy unavailable — select the email above.'}});
const reduceMotion=matchMedia('(prefers-reduced-motion: reduce)').matches;document.querySelectorAll('[data-reveal]').forEach((element)=>{if(reduceMotion||!('IntersectionObserver' in window))return;element.classList.add('reveal-ready');new IntersectionObserver((entries,observer)=>entries.forEach((entry)=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target)}}),{threshold:.12}).observe(element)});
const canvas=document.querySelector('[data-background-canvas]');if(canvas){canvas.dataset.motion=reduceMotion?'disabled':document.hidden?'paused':'running'}if(canvas&&!reduceMotion){const context=canvas.getContext('2d');let frame=0;const particles=Array.from({length:18},(_,i)=>({x:(i*53)%innerWidth,y:(i*89)%innerHeight,r:1+(i%2),v:.08+(i%3)*.03}));const resize=()=>{canvas.width=innerWidth;canvas.height=innerHeight};const draw=()=>{if(document.hidden){canvas.dataset.motion='paused';frame=0;return}canvas.dataset.motion='running';context.clearRect(0,0,canvas.width,canvas.height);context.fillStyle='rgba(84,214,196,.22)';particles.forEach((particle)=>{particle.y-=particle.v;if(particle.y<0)particle.y=canvas.height;context.fillRect(particle.x,particle.y,particle.r,particle.r)});frame=requestAnimationFrame(draw)};resize();addEventListener('resize',resize,{passive:true});draw();addEventListener('visibilitychange',()=>{if(!document.hidden&&!frame)draw()});addEventListener('pagehide',()=>cancelAnimationFrame(frame),{once:true})}
</script></body></html>
