---
import '../styles/global.css';
import { assetUrl, canonicalUrl, personJsonLd, socialImageUrl } from '../utils/seo';
import { site } from '../data/site';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  structuredData?: Record<string, unknown>;
  bodyClass?: string;
}

const { title = site.title, description = site.description, canonicalPath = '/', image, structuredData, bodyClass } = Astro.props as Props;
const canonical = canonicalUrl(canonicalPath);
const imageUrl = socialImageUrl(canonicalPath, image);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Anson Lin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <link rel="icon" href={assetUrl('favicon.svg')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData ?? (canonicalPath === '/' ? personJsonLd : undefined))}></script>
  </head>
  <body class={bodyClass}>
    <slot />
    <CommandPalette />
    <script is:inline>
      const nav = document.querySelector('[data-nav]');
      const toggle = document.querySelector('[data-menu]');
      const closeNav = (restore = false) => {
        nav?.setAttribute('data-open', 'false');
        toggle?.setAttribute('aria-expanded', 'false');
        if (restore) toggle?.focus();
      };
      toggle?.addEventListener('click', () => {
        const next = nav?.getAttribute('data-open') !== 'true';
        nav?.setAttribute('data-open', String(next));
        toggle.setAttribute('aria-expanded', String(next));
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        closeNav();
        setTimeout(() => toggle?.focus(), 0);
      }));

      const caseMenus = [...document.querySelectorAll('[data-case-menu]')];

      const dialog = document.querySelector('[data-palette]');
      const input = document.querySelector('[data-palette-input]');
      const opener = document.querySelector('[data-command]');
      const items = [...document.querySelectorAll('[data-palette-items] a')];
      let active = 0;
      const visibleItems = () => items.filter((item) => !item.hidden);
      const setActive = () => {
        const visible = visibleItems();
        if (active >= visible.length) active = 0;
        items.forEach((item) => item.removeAttribute('aria-current'));
        visible[active]?.setAttribute('aria-current', 'true');
      };
      const filterItems = () => {
        const query = input?.value.trim().toLowerCase() ?? '';
        items.forEach((item) => { item.hidden = !item.textContent?.toLowerCase().includes(query); });
        active = 0;
        setActive();
      };
      const openPalette = () => {
        dialog?.removeAttribute('hidden');
        if (input) input.value = '';
        items.forEach((item) => { item.hidden = false; });
        active = 0;
        setActive();
        input?.focus();
      };
      const closePalette = () => {
        dialog?.setAttribute('hidden', '');
        opener?.focus();
      };
      opener?.addEventListener('click', openPalette);
      input?.addEventListener('input', filterItems);
      items.forEach((item) => item.addEventListener('click', closePalette));

      document.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          openPalette();
        }
        if (event.key === 'Escape') {
          const paletteWasOpen = Boolean(dialog && !dialog.hasAttribute('hidden'));
          if (paletteWasOpen) {
            event.preventDefault();
            closePalette();
            return;
          }

          const openCaseMenu = caseMenus.find((menu) => menu.hasAttribute('open'));
          if (openCaseMenu) {
            event.preventDefault();
            openCaseMenu.removeAttribute('open');
            openCaseMenu.querySelector('summary')?.focus();
            return;
          }

          if (nav?.getAttribute('data-open') === 'true') {
            event.preventDefault();
            closeNav(true);
          }
        }
        if (dialog && !dialog.hasAttribute('hidden')) {
          const visible = visibleItems();
          if (event.key === 'ArrowDown' && visible.length) {
            event.preventDefault();
            active = (active + 1) % visible.length;
            setActive();
          }
          if (event.key === 'ArrowUp' && visible.length) {
            event.preventDefault();
            active = (active + visible.length - 1) % visible.length;
            setActive();
          }
          if (event.key === 'Enter') {
            event.preventDefault();
            visible[active]?.click();
          }
        }
      });
      document.addEventListener('click', (event) => {
        caseMenus.forEach((menu) => {
          if (!menu.contains(event.target)) menu.removeAttribute('open');
        });
      });

      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('[data-reveal]').forEach((element) => {
        if (reduceMotion || !('IntersectionObserver' in window)) return;
        element.classList.add('reveal-ready');
        new IntersectionObserver((entries, observer) => entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }), { threshold: .12 }).observe(element);
      });
    </script>
  </body>
</html>
